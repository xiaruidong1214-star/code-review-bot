# ---- 环境变量示例：复制为 .env 后按需修改 ----
# 应用
CRB_APP_NAME=code-review-bot
CRB_ENV=dev
# 默认只监听回环地址。本服务背后是**按量计费的 LLM**，暴露到公网前
# 必须先设置 CRB_API_KEY（或把鉴权放在反向代理层）。
CRB_HOST=127.0.0.1
CRB_PORT=8000
CRB_LOG_LEVEL=INFO
CRB_LOG_JSON=true

# 鉴权：留空 = 不校验（仅适合本机自用）；非空则业务端点要求 X-API-Key 请求头
CRB_API_KEY=

# Redis（缓存 / 分布式锁 / 任务进度）
CRB_REDIS_URL=redis://localhost:6379/0
CRB_CACHE_TTL_SECONDS=3600
CRB_LOCK_TTL_SECONDS=45
CRB_SINGLEFLIGHT_WAIT_SECONDS=30
CRB_RESULT_TTL_SECONDS=1800

# SQLite
CRB_DB_PATH=data/reviews.db

# LLM（DeepSeek，OpenAI 兼容协议）
CRB_LLM_BASE_URL=https://api.deepseek.com
CRB_LLM_MODEL=deepseek-chat
CRB_LLM_API_KEY=
CRB_LLM_TIMEOUT_SECONDS=60
CRB_LLM_MAX_RETRIES=2
CRB_LLM_MAX_INPUT_CHARS=20000

# 输入限制
CRB_MAX_CODE_BYTES=1048576
CRB_MAX_STREAM_BYTES=1048576

# GitHub 抓取（SSRF 防护）
CRB_GITHUB_TOKEN=
CRB_GITHUB_ALLOWED_HOSTS=github.com,raw.githubusercontent.com
CRB_GITHUB_MAX_FILE_BYTES=262144
CRB_GITHUB_TIMEOUT_SECONDS=15

# Celery（可选；留空则 API 进程内线程池执行）
CRB_CELERY_BROKER_URL=
CRB_CELERY_RESULT_BACKEND=

# 进入 AST 分析的 LLM 之前，是否跳过纯启发式结论
CRB_RATE_LIMIT_PER_MINUTE=60
